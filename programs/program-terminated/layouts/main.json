{
  "schema": 1,
  "id": "main",
  "root": {
    "id": "dump",
    "type": "stack",
    "children": [
      {
        "id": "summary-section",
        "type": "section",
        "title": {
          "package": "the8020/uui",
          "key": "layouts.program-terminated.main.summary-section.title",
          "fallback": "Summary"
        },
        "children": [
          {
            "id": "summary",
            "type": "grid",
            "columns": 2,
            "responsive": "stack",
            "children": [
              {
                "id": "exception-summary",
                "type": "field-group",
                "title": {
                  "package": "the8020/uui",
                  "key": "layouts.program-terminated.main.exception-summary.title",
                  "fallback": "Exception"
                },
                "controls": [
                  "exception-type",
                  "message",
                  "properties"
                ]
              },
              {
                "id": "execution-summary",
                "type": "field-group",
                "title": {
                  "package": "the8020/uui",
                  "key": "layouts.program-terminated.main.execution-summary.title",
                  "fallback": "Execution"
                },
                "controls": [
                  "program-id",
                  "entrypoint",
                  "location",
                  "occurred-at",
                  "copy-status"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "technical-details-section",
        "type": "section",
        "title": {
          "package": "the8020/uui",
          "key": "layouts.program-terminated.main.technical-details-section.title",
          "fallback": "Technical details"
        },
        "children": [
          {
            "id": "technical-details",
            "type": "tabs",
            "selectedTab": "call-stack",
            "children": [
              {
                "id": "call-stack",
                "type": "field-group",
                "title": {
                  "package": "the8020/uui",
                  "key": "short_dump.call_stack",
                  "fallback": "Call stack"
                },
                "controls": [
                  "stack"
                ]
              },
              {
                "id": "source-code",
                "type": "field-group",
                "title": {
                  "package": "the8020/uui",
                  "key": "layouts.program-terminated.main.source-code.title",
                  "fallback": "Source code"
                },
                "controls": [
                  "source"
                ]
              },
              {
                "id": "complete-dump",
                "type": "field-group",
                "title": {
                  "package": "the8020/uui",
                  "key": "layouts.program-terminated.main.complete-dump.title",
                  "fallback": "Complete short dump"
                },
                "controls": [
                  "dump-text"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
