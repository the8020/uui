{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "fmt": {
    "exclude": [
      "services/shell/.generated",
      "services/shell/frontend/assets",
      "services/shell/frontend/components/list/vendor",
      "services/shell/frontend/components/code-editor/vendor"
    ]
  },
  "lint": {
    "exclude": [
      "services/shell/.generated",
      "services/shell/frontend/assets",
      "services/shell/frontend/components/list/vendor",
      "services/shell/frontend/components/code-editor/vendor"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "/p/": "file:///workspace/packages/",
    "@the8020/http": "file:///opt/runtime/http/the8020_http.js",
    "@the8020/kernel": "file:///opt/runtime/kernel/mod.ts",
    "@the8020/protocol": "file:///opt/runtime/protocol.ts",
    "hono": "jsr:@hono/hono@4.9.8",
    "kysely": "npm:kysely@0.29.4",
    "markdown-it": "npm:markdown-it@14.1.0",
    "zod": "npm:zod@4.1.5",
    "@the8020/context": "file:///opt/runtime/context/mod.ts"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check --import-map=deno.local.json mod.ts tables/sessions.ts services/login/service.ts services/shell/service.ts services/shell/asset_delivery_e2e.ts services/session/service.ts programs/home/program.ts programs/program-terminated/program.ts programs/sessions/program.ts services/shell/frontend/main.ts presentation_browser_e2e.ts keyboard_browser_fixture.ts download_browser_e2e.ts services/shell/frontend/components/code-editor/editor.ts",
    "test": "deno test --import-map=deno.local.json --allow-read --allow-write .",
    "test:presentation-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts",
    "test:native-back-browser": "xvfb-run -a deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --native-back",
    "test:connection-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --connection",
    "test:download-browser": "deno run -A --import-map=deno.local.json download_browser_e2e.ts",
    "test:lists-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --lists",
    "test:programs-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --programs",
    "test:custom-elements-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --custom-elements",
    "test:asset-delivery": "deno run -A --unstable-worker-options --import-map=deno.local.json services/shell/asset_delivery_e2e.ts",
    "test:code-editor-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --fixture=./services/shell/frontend/components/code-editor/browser_fixture.ts",
    "test:keyboard-browser": "deno run -A --import-map=deno.local.json presentation_browser_e2e.ts --fixture=./keyboard_browser_fixture.ts"
  }
}
