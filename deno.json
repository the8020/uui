{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "fmt": {
    "exclude": [
      "services/shell/.generated",
      "services/shell/frontend/assets"
    ]
  },
  "lint": {
    "exclude": [
      "services/shell/.generated",
      "services/shell/frontend/assets"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@the8020/http": "../kernel/defaults/config/runtime/deno/http/mod.ts",
    "@the8020/kernel": "../kernel/defaults/config/runtime/deno/kernel/mod.ts",
    "@the8020/protocol": "../kernel/defaults/config/runtime/protocol/generated.ts",
    "@packages/the8020/uui/": "./",
    "@packages/the8020/admin-core/": "../admin-core/",
    "@packages/the8020/demo/": "../demo/",
    "@packages/the8020/dev-core/": "../dev-core/",
    "@xterm/addon-canvas": "npm:@xterm/addon-canvas@0.7.0",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.10.0",
    "@xterm/xterm": "npm:@xterm/xterm@5.5.0",
    "hono": "jsr:@hono/hono@4.9.8",
    "markdown-it": "npm:markdown-it@14.1.0",
    "zod": "npm:zod@4.1.5"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check mod.ts services/login/service.ts services/shell/service.ts services/session/service.ts programs/home/program.ts programs/program-terminated/program.ts programs/sessions/program.ts services/shell/frontend/main.ts",
    "test": "deno test --allow-read=.,../admin-core,../demo,../dev-core,../kernel/defaults/config/runtime,/tmp --allow-write=/tmp ."
  }
}
